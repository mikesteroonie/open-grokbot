# ---- Required ----------------------------------------------------------
# AgentMail: every bot gets its own real inbox. https://agentmail.to
AGENTMAIL_API_KEY=
# xAI: Grok powers the bots. https://console.x.ai
XAI_API_KEY=

# ---- Recommended -------------------------------------------------------
# Exa web search — what lets bots research anything current. https://exa.ai
EXA_API_KEY=

# ---- Optional ----------------------------------------------------------
# Verified domain for bot addresses (default: agentmail.to)
# AGENTMAIL_DOMAIN=
# Webhook secret (whsec_...) so bots react to inbound email
# AGENTMAIL_WEBHOOK_SECRET=
# Your email, for notify_principal escalations
# PRINCIPAL_EMAIL=
# Model override (default grok-4.6)
# AI_MODEL_ID=
